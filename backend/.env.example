# PAKIS ONE — contoh konfigurasi lingkungan.
# Berkas ini masuk git: JANGAN isi nilai rahasia. Secret hanya di .env / secret CI (SEC-060).
# Parameter bisnis (radius, toleransi, timeout, dll.) TIDAK di sini, melainkan di registri setting (08 §2).

APP_NAME="PAKIS ONE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Rotasi APP_KEY (SEC-011): isi kunci lama, dipisah koma.
APP_PREVIOUS_KEYS=

# Penyimpanan waktu selalu UTC. Zona tampilan dari setting general.timezone.
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# json = storage/logs/pakis-YYYY-MM-DD.log, satu objek JSON per baris dengan request_id (T-003)
LOG_STACK=json
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB 11.8 (ADR-012). Lokal: XAMPP port 3307.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=pakis_one
DB_USERNAME=root
DB_PASSWORD=

# Lokal memakai driver database. Produksi: redis (03 §5).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Content-Security-Policy (SEC-063): enforce (produksi) | report-only (lokal, staging) | off
CSP_MODE=report-only

# Wajib true di staging/produksi (HTTPS) — SEC-005.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Produksi: Redis dengan password (SEC-060). Tidak dipakai di lokal XAMPP.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: email ditulis ke log. Staging/produksi: SMTP (OQ-012).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Kunci HMAC untuk nik_hash (SEC-010). Terpisah dari APP_KEY dan disimpan terpisah dari backup DB (SEC-011).
# Buat nilai acak 64 karakter hex. Mengganti kunci ini butuh re-hash terencana.
NIK_HASH_KEY=

# Akun Super Admin pertama dibuat oleh SuperAdminSeeder (04 §4).
# Seeder gagal bila kosong atau password < 16 karakter (SEC-008).
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Kanal OTP lupa password. "log" = tulis ke log (lokal). Driver WhatsApp menunggu OQ-004.
# OTP lupa password (T-015): `none` (kanal mati), `log` (lokal: kode ditulis ke storage/logs/otp-*.log;
# DITOLAK di produksi), Telegram juga `bot`. Penyedia WhatsApp menunggu OQ-004.
OTP_WHATSAPP_DRIVER=log
OTP_TELEGRAM_DRIVER=log
# Bot Telegram (@BotFather). Rahasia: isi di .env server saja.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
OTP_PROVIDER_SENDER=

VITE_APP_NAME="${APP_NAME}"
