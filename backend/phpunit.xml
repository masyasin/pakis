<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Kontrak lintas modul: format galat API, standar listing (10 §1, §3) -->
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
        <!-- Penjaga arsitektur lintas domain berbasis pemindaian statis (PeriodGuard, StockLedger; T-077) -->
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <!-- Proses paralel sungguhan, tanpa RefreshDatabase (ADR-009) -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
        <!-- Uji volume (T-077, 1 juta mutasi): hanya dijalankan manual dengan opsi group=volume -->
        <testsuite name="Volume">
            <directory>tests/Volume</directory>
        </testsuite>
    </testsuites>
    <!-- Grup volume dikecualikan dari run biasa & CI; opsi group=volume di baris perintah membatalkan pengecualian ini. -->
    <groups>
        <exclude>
            <group>volume</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Tipe impor uji (T-085A): mendaftarkan tests/Fixtures/Import/ProductLikeImportType. -->
        <env name="IMPORT_TEST_TYPE" value="Tests\Fixtures\Import\ProductLikeImportType"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Test memakai MariaDB (bukan sqlite) agar trigger, FOR UPDATE, dan collation teruji di mesin produksi (ADR-012) -->
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_DATABASE" value="pakis_one_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
